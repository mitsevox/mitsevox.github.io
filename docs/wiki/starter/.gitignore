# Local inputs and the private build environment are outside public Git.
/orig/*/*
!/orig/*/.gitkeep
/private/
/build/
/scratch/

# Original executables, debug databases, object files and library archives.
*.[dD][oO][lL]
*.[rR][eE][lL]
*.[eE][lL][fF]
*.[mM][aA][pP]
*.[oO]
*.[aA]
*.[bB][iI][nN]

# Disc images.
*.[iI][sS][oO]
*.[gG][cC][mM]
*.[rR][vV][zZ]
*.[wW][iI][aA]
*.[wW][bB][fF][sS]
*.[nN][fF][sS]
*.[gG][cC][zZ]
*.[tT][gG][cC]

# Local filesystem metadata and Python caches.
.DS_Store
__pycache__/
.mypy_cache/
.cache/

# Local IDE state.
.idea/
.vs/

# dtk-template generated files.
.ninja_*
build.ninja
objdiff.json
compile_commands.json
ctx.*
*.ctx
*.[eE][xX][eE]
