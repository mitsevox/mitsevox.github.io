# Reference orchestration. Implement CI.md's adapter, replace project facts and
# adopt the owner's policies before renaming this file to validate.yml.
# Stage names are part of the reviewed producer policy; change them together.
name: Validate
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
    inputs:
      audit_build_cache:
        description: Force fresh main validation and permit an enabled build-cache save
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: validate-${{ github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
jobs:
  validate:
    name: Build and measure
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: read
      packages: read
      actions: read
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: astral-sh/setup-uv@d0d8abe699bfb85fec6de9f7adb5ae17292296ff
        with:
          version: '0.12.9'
      - name: Validate configuration and evidence
        id: configuration
        run: python3 tools/project_ci.py configure
      - name: Restore inventory candidate
        id: inventory
        if: steps.configuration.outputs.inventory_cache == 'true'
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830
        with:
          path: build/inventory
          key: ${{ steps.configuration.outputs.inventory_key }}
          restore-keys: ${{ steps.configuration.outputs.inventory_prefix }}
      - name: Select complete source proof
        id: proof
        if: github.ref == 'refs/heads/main' && steps.configuration.outputs.proof_reuse == 'true' && !(github.event_name == 'workflow_dispatch' && inputs.audit_build_cache == true)
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 tools/project_ci.py select-proof
      - name: Decide validation lanes
        id: plan
        env:
          PROOF_REUSED: ${{ steps.proof.outputs.reused || 'false' }}
          INVENTORY_HIT: ${{ steps.inventory.outputs.cache-hit || 'false' }}
          AUDIT_REQUESTED: ${{ github.event_name == 'workflow_dispatch' && inputs.audit_build_cache == true }}
        run: python3 tools/project_ci.py plan
      - name: Verify ledger provenance
        if: steps.plan.outputs.full == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 tools/project_ci.py ledger
      - name: Verify baseline and prepare tools
        if: steps.plan.outputs.full == 'true'
        run: python3 tools/project_ci.py baseline
      - name: Restore build cache candidate
        if: steps.plan.outputs.full == 'true' && steps.configuration.outputs.build_cache == 'true'
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830
        with:
          path: build/cache
          key: ${{ steps.configuration.outputs.build_prefix }}${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: ${{ steps.configuration.outputs.build_prefix }}
      - name: Build complete target
        if: steps.plan.outputs.full == 'true'
        run: python3 tools/project_ci.py build
      - name: Verify inventory
        if: steps.plan.outputs.inventory == 'true'
        run: python3 tools/project_ci.py inventory
      - name: Verify tools and contracts
        if: steps.plan.outputs.full == 'true'
        run: python3 tools/project_ci.py test
      - name: Measure source
        id: measure
        if: steps.plan.outputs.full == 'true'
        run: python3 tools/project_ci.py compare
      - name: Export measured report
        if: steps.plan.outputs.full == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 tools/project_ci.py export
      - name: Verify host receipts
        if: steps.plan.outputs.full == 'true'
        env:
          LIVE_RECEIPTS: ${{ github.event_name != 'pull_request' || steps.measure.outputs.cache_reused == '0' }}
        run: python3 tools/project_ci.py host-check
      - name: Authenticate complete source proof
        if: steps.plan.outputs.reused == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 tools/project_ci.py promote-proof
      - name: Package public report
        if: github.ref == 'refs/heads/main' || (github.event_name == 'pull_request' && steps.measure.outputs.cache_reused == '0')
        run: python3 tools/project_ci.py package
      - name: Validate public report
        if: github.ref == 'refs/heads/main' || (github.event_name == 'pull_request' && steps.measure.outputs.cache_reused == '0')
        run: python3 tools/project_ci.py validate-package
      - name: Upload public report
        if: github.ref == 'refs/heads/main' || (github.event_name == 'pull_request' && steps.measure.outputs.cache_reused == '0')
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: public-report
          path: build/public-report/*.json
          if-no-files-found: error
          retention-days: 30
      - name: Save verified inventory
        if: github.ref == 'refs/heads/main' && steps.configuration.outputs.inventory_cache == 'true' && steps.inventory.outputs.cache-hit != 'true' && (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.audit_build_cache == true))
        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830
        with:
          path: build/inventory
          key: ${{ steps.configuration.outputs.inventory_key }}
      - name: Save audited build cache
        if: github.ref == 'refs/heads/main' && steps.plan.outputs.full == 'true' && steps.configuration.outputs.build_cache == 'true' && (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.audit_build_cache == true))
        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830
        with:
          path: build/cache
          key: ${{ steps.configuration.outputs.build_prefix }}${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
