{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "built_at": {
            "type": "string",
            "format": "date-time"
          },
          "code": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "linked": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "total",
              "linked"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "linked": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "total",
              "linked"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "measured",
                  "inherited",
                  "reconstructed"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "type": "object"
              }
            },
            "required": [
              "kind",
              "source"
            ]
          }
        },
        "required": [
          "revision",
          "built_at",
          "code",
          "data",
          "provenance"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "snapshots"
  ]
}
