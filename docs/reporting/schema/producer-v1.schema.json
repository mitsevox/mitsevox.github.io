{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "console": {
          "type": "string",
          "minLength": 1
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "id",
        "console",
        "sha1"
      ]
    },
    "workflow": {
      "type": "string",
      "pattern": "^\\.github/workflows/[A-Za-z0-9_-]+\\.ya?ml$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "workflowBlobs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "minItems": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "requiredSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "identity"
        ]
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reused": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "full"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "target",
    "workflow",
    "branch",
    "workflowBlobs",
    "artifact",
    "job",
    "requiredSteps",
    "tools",
    "lanes"
  ]
}
