{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public map v2 with optional node evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "required": [
    "schemaVersion",
    "sections",
    "files"
  ],
  "$defs": {
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[A-Za-z0-9_.+-]+(?:/[A-Za-z0-9_.+-]+)*(?![\\s\\S])"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "code",
            "data"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "linked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fuzzy": {
          "type": "number",
          "minimum": 0
        },
        "address": {
          "type": "string",
          "pattern": "^0x[A-F0-9]{8,16}$"
        },
        "mapped_extents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^0x[A-F0-9]{8,16}$"
              },
              "end": {
                "type": "string",
                "pattern": "^0x[A-F0-9]{8,16}$"
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "minItems": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1
        },
        "type": {
          "enum": [
            "file",
            "function",
            "section",
            "gap",
            "group"
          ]
        },
        "function_address": {
          "type": "string",
          "pattern": "^0x[A-F0-9]{8,16}$"
        },
        "original_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "$ref": "#/$defs/sourcePath"
        },
        "comparison_source": {
          "$ref": "#/$defs/sourcePath"
        },
        "complete": {
          "type": "boolean"
        },
        "auto_generated": {
          "type": "boolean",
          "const": true
        },
        "boundary": {
          "enum": [
            "exact",
            "provisional",
            "open"
          ]
        },
        "scope": {
          "enum": [
            "mapped-ranges",
            "candidate-ranges"
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "size",
        "linked",
        "matched"
      ],
      "dependentSchemas": {
        "source": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "file",
                "group",
                "function"
              ]
            }
          }
        },
        "comparison_source": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "function"
              ]
            }
          }
        },
        "complete": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "file"
              ]
            }
          }
        },
        "auto_generated": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "file"
              ]
            }
          }
        },
        "boundary": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "file"
              ]
            }
          }
        },
        "scope": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "file"
              ]
            }
          }
        }
      }
    }
  }
}
