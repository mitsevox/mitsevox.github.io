{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "target_sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "contribution_basis": {
      "const": "exact-functions"
    },
    "credited_functions": {
      "type": "integer",
      "minimum": 0
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "functions": {
            "type": "integer",
            "minimum": 1
          },
          "pull_requests": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "login",
          "id",
          "functions",
          "pull_requests"
        ]
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "built_at": {
            "type": "string",
            "format": "date-time"
          },
          "code": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "linked": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "total",
              "linked"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "linked": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "total",
              "linked"
            ]
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "verified-source-build"
                  },
                  "report_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "report_sha256"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "workflow-artifact"
                  },
                  "report_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "run": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "artifact": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "report_sha256",
                  "run",
                  "artifact"
                ]
              }
            ]
          }
        },
        "required": [
          "revision",
          "built_at",
          "code",
          "data",
          "provenance"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "target",
    "target_sha1",
    "revision",
    "contribution_basis",
    "credited_functions",
    "contributors",
    "snapshots"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
