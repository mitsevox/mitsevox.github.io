{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "gameId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "discRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  },
  "required": [
    "id",
    "platform",
    "gameId",
    "region",
    "discRevision",
    "sha1"
  ]
}
