{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "data"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "linked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "matched": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fuzzy": {
            "type": "number",
            "minimum": 0
          },
          "address": {
            "type": "string",
            "pattern": "^0x[A-F0-9]{8,16}$"
          },
          "mapped_extents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^0x[A-F0-9]{8,16}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^0x[A-F0-9]{8,16}$"
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            "minItems": 1
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            },
            "minItems": 1
          },
          "type": {
            "enum": [
              "file",
              "function",
              "section",
              "gap"
            ]
          },
          "function_address": {
            "type": "string",
            "pattern": "^0x[A-F0-9]{8,16}$"
          },
          "original_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "kind",
          "size",
          "linked",
          "matched"
        ]
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "data"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "linked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "matched": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fuzzy": {
            "type": "number",
            "minimum": 0
          },
          "address": {
            "type": "string",
            "pattern": "^0x[A-F0-9]{8,16}$"
          },
          "mapped_extents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^0x[A-F0-9]{8,16}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^0x[A-F0-9]{8,16}$"
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            "minItems": 1
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            },
            "minItems": 1
          },
          "type": {
            "enum": [
              "file",
              "function",
              "section",
              "gap"
            ]
          },
          "function_address": {
            "type": "string",
            "pattern": "^0x[A-F0-9]{8,16}$"
          },
          "original_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "kind",
          "size",
          "linked",
          "matched"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "sections",
    "files"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "code",
            "data"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "linked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fuzzy": {
          "type": "number",
          "minimum": 0
        },
        "address": {
          "type": "string",
          "pattern": "^0x[A-F0-9]{8,16}$"
        },
        "mapped_extents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^0x[A-F0-9]{8,16}$"
              },
              "end": {
                "type": "string",
                "pattern": "^0x[A-F0-9]{8,16}$"
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "minItems": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1
        },
        "type": {
          "enum": [
            "file",
            "function",
            "section",
            "gap"
          ]
        },
        "function_address": {
          "type": "string",
          "pattern": "^0x[A-F0-9]{8,16}$"
        },
        "original_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "kind",
        "size",
        "linked",
        "matched"
      ]
    }
  }
