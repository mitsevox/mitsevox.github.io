      "mergeRuleset": {"name": "merges", "bypassActors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"}]},
      "merge": "squash",
      "autoDeleteHeadBranches": true,
      "allowedActions": {"githubOwned": true, "verified": false, "patterns": ["mitsevox/mitsevox.github.io/.github/actions/*"]},
      "defaultTokenPermissions": "read",
      "actionsApprovePullRequests": false,
      "forkPullRequestApproval": "all_external_contributors",
      "retentionDays": 30,
      "variables": ["DATA_APP_CLIENT_ID"],
      "secrets": [],
      "environments": {"publish": {"branches": ["main"], "secrets": ["DATA_APP_PRIVATE_KEY"]}, "validate": {"branches": null, "secrets": []}},
      "security": {"secretScanning": true, "pushProtection": true, "dependabotAlerts": true, "privateVulnerabilityReporting": true, "dependabotVersionUpdates": false},
      "features": {"issues": true, "wiki": false, "projects": false, "discussions": false},
